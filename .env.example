# ===========================================
# ESTETICA PLATFORM - Variables de Entorno
# ===========================================
# Copia este archivo a .env y completa los valores
# NUNCA commitees el archivo .env real

# -------------------------------------------
# Base de Datos (PostgreSQL)
# -------------------------------------------
POSTGRES_DB=estetica
POSTGRES_USER=estetica
POSTGRES_PASSWORD=cambia_esta_password_en_prod

# -------------------------------------------
# Clave interna para comunicación entre servicios
# -------------------------------------------
INTERNAL_API_KEY=dev-internal-key-change-in-prod

# -------------------------------------------
# Telegram Bot
# -------------------------------------------
TELEGRAM_BOT_TOKEN=tu_token_de_botfather_aqui
TELEGRAM_WEBHOOK_SECRET=tu_webhook_secret_aqui
ADMIN_TELEGRAM_CHAT_ID=123456789

# -------------------------------------------
# LLM (Nemotron Nano Omni)
# -------------------------------------------
LLM_PROVIDER=nemotron
LLM_API_KEY=tu_api_key_de_nemotron_aqui
LLM_MODEL=nemotron-nano-omni

# -------------------------------------------
# RAG (Databricks) - En dev usa el mock
# -------------------------------------------
DATABRICKS_RAG_URL=http://rag-mock:8000
DATABRICKS_TOKEN=tu_token_de_databricks_aqui

# -------------------------------------------
# Booking Service URLs
# -------------------------------------------
BOOKING_SERVICE_URL=http://booking-service:8000

# -------------------------------------------
# Google Calendar / Gmail (OAuth 2.0)
# -------------------------------------------
GOOGLE_CLIENT_ID=tu_google_client_id
GOOGLE_CLIENT_SECRET=tu_google_client_secret
GOOGLE_REFRESH_TOKEN=tu_google_refresh_token

# -------------------------------------------
# Email (SMTP / Gmail API / Proveedor transaccional)
# -------------------------------------------
EMAIL_FROM=noreply@tudominio.cl
EMAIL_PROVIDER_KEY=tu_api_key_de_email
ADMIN_EMAIL=admin@tudominio.cl

# -------------------------------------------
# Configuración de Zona Horaria y Negocio
# -------------------------------------------
TIMEZONE=America/Santiago
CANCEL_MIN_HOURS=24
BOOKING_MAX_HORIZON_DAYS=60
GRID_SIZE_MINUTES=15
MAX_ACTIVE_BOOKINGS_PER_CLIENT=3

# -------------------------------------------
# Voz (Fase 5) - Proveedores STT/TTS
# -------------------------------------------
STT_PROVIDER=mock
TTS_PROVIDER=mock

# -------------------------------------------
# WhatsApp (Fase 6) - Meta Cloud API
# -------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id_aqui
WHATSAPP_ACCESS_TOKEN=tu_access_token_aqui
WHATSAPP_WEBHOOK_VERIFY_TOKEN=ayudio_webhook_verify
WHATSAPP_BUSINESS_ACCOUNT_ID=tu_business_account_id_aqui

# -------------------------------------------
# Landing Page
# -------------------------------------------
VITE_BOT_USERNAME=ayudio
VITE_API_URL=http://localhost:8000